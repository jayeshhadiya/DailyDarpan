{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/current-affairs/browser",
  "trailingSlash": false,
  "redirects": [
    { "source": "/current-affairs", "destination": "/", "permanent": true },
    { "source": "/en/current-affairs", "destination": "/en", "permanent": true }
  ],
  "headers": [
    {
      "source": "/:file((?:main|chunk|polyfills|styles)-[^/]+\\.(?:js|css))",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
