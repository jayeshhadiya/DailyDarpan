{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/current-affairs/browser",
  "routes": [
    { "src": "^/(.+)/$", "status": 308, "headers": { "Location": "/$1" } },
    { "src": "^/current-affairs$", "status": 308, "headers": { "Location": "/" } },
    { "src": "^/gu/current-affairs$", "status": 308, "headers": { "Location": "/gu" } },
    {
      "src": "^/(?:main|chunk|polyfills|styles)-[^/]+\\.(?:js|css)$",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    { "src": "^/api/visits$", "dest": "/api/visits", "headers": { "Cache-Control": "no-store" } },
    { "handle": "filesystem" },
    { "src": "^/gu/.*$", "status": 404, "dest": "/gu/404/index.html" },
    { "src": "^/.*$", "status": 404, "dest": "/404.html" }
  ]
}
